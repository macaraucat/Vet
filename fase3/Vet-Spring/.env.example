# JWT
# Clave HMAC-SHA256 en Base64 (mínimo 256 bits / 32 bytes).
# Generar con:  openssl rand -base64 32
JWT_SECRET=

# Comunicación interna entre auth-service y user-service
# Cadena aleatoria larga. Debe ser idéntica en ambos servicios.
# Generar con:  openssl rand -hex 32
INTERNAL_API_KEY=

# Base de datos MySQL
# URL base SIN el nombre de la BD. Cada servicio añade la suya:
#   user-service    -> ${DB_URL}/vet_usuarios
#   product-service -> ${DB_URL}/vet_productos
DB_URL=jdbc:mysql://localhost:3306
DB_USERNAME=root
DB_PASSWORD=

# CORS
# Origen(es) del frontend. Varios separados por coma.
# Local:  CORS_ORIGINS=http://localhost:5173
# EC2:    CORS_ORIGINS=http://<elastic-ip>:5173
CORS_ORIGINS=http://localhost:5173